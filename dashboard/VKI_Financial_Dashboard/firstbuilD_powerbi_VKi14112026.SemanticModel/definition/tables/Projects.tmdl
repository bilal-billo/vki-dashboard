	partition Projects = m
		mode: import
		source =
				let
				      Source = CommonDataService.Database("operations-vki-prod.crm4.dynamics.com"),
				      Nav = Source{[Schema="dbo",Item="msdyn_project"]}[Data],
				      Cols = Table.SelectColumns(Nav,{
				          "msdyn_projectid", "msdyn_projectnumber", "msdyn_subject",
				          "craef_vkistatnumber", "msdyn_scheduledstart", "msdyn_finish",
				          "craef_vkidepartment", "msdyn_projectmanager", "msdyn_projectmanagername",
				          "msdyn_contractorganizationalunitid"
				      }),
				      Renamed = Table.RenameColumns(Cols, {
				          {"msdyn_projectid", "ProjectID"}, {"msdyn_projectnumber", "ProjectNumber"},
				          {"msdyn_subject", "ProjectName"}, {"craef_vkistatnumber", "StatNumber"},
				          {"msdyn_scheduledstart", "StartDate"}, {"msdyn_finish", "EndDate"},
				          {"craef_vkidepartment", "DepartmentCode"}, {"msdyn_projectmanager", "EmployeeID"},
				          {"msdyn_projectmanagername", "ProjectManager"},
				          {"msdyn_contractorganizationalunitid", "ContractingUnitID"}
				      }),
				      Filtered = Table.SelectRows(Renamed, each
				          [StatNumber] <> null and
				          (Text.At([StatNumber], 2) = "R" or Text.At([StatNumber], 2) = "O")
				      ),
				      Dept = Table.AddColumn(Filtered, "Department", each
				          if [DepartmentCode] = 252580002 then "AR"
				          else if [DepartmentCode] = 252580001 then "EA"
				          else if [DepartmentCode] = 252580003 then "TP"
				          else "Other"),
				      Types = Table.TransformColumnTypes(Dept, {
				          {"StartDate", type datetime}, {"EndDate", type datetime}
				      }),
				      OrgUnitsRaw = Source{[Schema="dbo",Item="msdyn_organizationalunit"]}[Data],
				      OrgUnitsCols = Table.SelectColumns(OrgUnitsRaw, {"msdyn_organizationalunitid", "msdyn_name"}),
				      Merged = Table.NestedJoin(Types, {"ContractingUnitID"}, OrgUnitsCols, {"msdyn_organizationalunitid"}, "OrgData", JoinKind.LeftOuter),
				      Expanded = Table.ExpandTableColumn(Merged, "OrgData", {"msdyn_name"}, {"ContractType"})
				  in
				      Expanded

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

