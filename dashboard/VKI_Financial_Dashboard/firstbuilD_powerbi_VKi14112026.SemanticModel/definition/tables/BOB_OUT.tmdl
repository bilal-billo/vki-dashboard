	column LedgerDimensionValuesJson
		dataType: string
		lineageTag: 9949ff88-c165-4ec3-8ffb-af21020fc982
		summarizeBy: none
		sourceColumn: LedgerDimensionValuesJson

		annotation SummarizationSetBy = Automatic

	column FOProjectId = ```
			
			VAR _json = BOB_OUT[LedgerDimensionValuesJson]
			VAR _key = """PROJECT"":"""
			VAR _pos = FIND(_key, _json, 1, 0)
			RETURN IF(
			    _pos = 0 || ISBLANK(_json),
			    BLANK(),
			    VAR _start = _pos + LEN(_key)
			    RETURN MID(_json, _start, FIND("""", _json, _start) - _start)
			)
			
			```
		lineageTag: 7a03b59a-67f6-4851-bc90-ceebf36218bc
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column MainAccount
		dataType: string
		lineageTag: 848fba14-08ea-40b2-9576-03a28e1ac5c9
		summarizeBy: none
		sourceColumn: MainAccount

		annotation SummarizationSetBy = Automatic

	column 'GL Account Prefix' = LEFT([MainAccount], 2)
		dataType: string
		lineageTag: e8597665-68eb-4187-80e6-cc739f8319be

	partition BOB_OUT = m
		mode: import
		source =
				let
				    Source = OData.Feed(
				        "https://vki-prod.operations.eu.dynamics.com/data/GeneralJournalAccountEntryBiEntities?$select=GeneralJournalEntry,AccountingCurrencyAmount,LedgerDimensionValuesJson,Text,PostingType",
				        null, [Implementation="2.0"]
				    ),
				    AddedMainAccount = Table.AddColumn(Source, "MainAccount", each try Json.Document([LedgerDimensionValuesJson]){0}[MAINACCOUNT] otherwise null, type text)
				in
				    AddedMainAccount

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

