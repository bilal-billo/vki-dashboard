table OdooData
	lineageTag: e442e87d-4c83-4e3f-991c-99eea67464d8

	column PeriodDate = ```
			
			  VAR _pos = FIND("/", OdooData[period])
			  VAR _month = VALUE(LEFT(OdooData[period], _pos - 1))
			  VAR _year = VALUE(RIGHT(OdooData[period], 4))
			  RETURN DATE(_year, _month, 1)
			```
		formatString: General Date
		lineageTag: 78725c7d-7c97-4ee4-8233-bcd9803ac306
