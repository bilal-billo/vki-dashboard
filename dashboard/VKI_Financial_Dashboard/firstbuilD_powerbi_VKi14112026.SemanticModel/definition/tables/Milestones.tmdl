table Milestones
	lineageTag: 02020d89-1735-46d4-ba3b-fc7e22b08aa6

	measure 'Total WANI' = ```
			
			          CALCULATE(SUM(OdooData[Amount]), OdooData[AnalyticalJournal] = "WANI")
			```
		isHidden
		lineageTag: 37ee03b8-3c6f-4ad1-94fb-b21d1727952f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Remaining Over Time' = ```
			
			          [Total Budget] - [Revenues Booked Cumulative]
			```
		isHidden
		lineageTag: 0d47a37c-d034-4a28-a3e8-ab38fbadb92a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Revenues Booked Cumulative' = ```
			
			          VAR MaxDate = MAX(Dates[Date])
			          RETURN
			          IF(
			              ISBLANK(MaxDate),
			              BLANK(),
			              CALCULATE(
			                  SUM(Milestones[Line Amount]),
			                  ALL(Milestones[Milestone date]),
			                  Milestones[Milestone date] <= MaxDate,
			                  Milestones[msdyn_invoicestatus] = 192350003
			              )
			          )
			```
		isHidden
		lineageTag: deab9b9e-af91-462a-a857-ac31a599d0f5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Direct Costs OH' = ```
			
			          -1 * SUMX(
			              OdooData,
			              IF(OdooData[AnalyticalJournal] <> "WANI" && OdooData[AnalyticalJournal] <> "Invoice",
			                  OdooData[Amount] * SWITCH(TRUE(),
			                      OdooData[AnalyticalJournal] = "T1 Manpower", 1.55,
			                      LEFT(OdooData[AnalyticalJournal], 2) = "T3", 1.55,
			                      1), 0))
			```
		isHidden
		lineageTag: c04e1e0a-20fc-4141-afe8-cfd015447f77

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Claimable' = ```
			
			          -1 * SUMX(
			              OdooData,
			              IF(OdooData[AnalyticalJournal] <> "WANI" && OdooData[AnalyticalJournal] <> "Invoice",
			                  VAR ProjType = LOOKUPVALUE(Projects[ContractType], Projects[VKI Stat Number], OdooData[StatNumber])
			                  VAR Journal = OdooData[AnalyticalJournal]
			                  VAR IsT1T3 = Journal = "T1 Manpower" || LEFT(Journal, 2) = "T3"
			                  VAR IsT5 = Journal = "T5 Suppliers"
			                  VAR IsT4 = LEFT(Journal, 2) = "T4"
			                  VAR Coef = SWITCH(ProjType,
			                      "EU", IF(IsT5, 1, 1.25), "FOD", 1.15,
			                      "PRODEX", IF(IsT5 || IsT4, 1, 1.05),
			                      "RW", IF(IsT1T3, BLANK(), 1.17),
			                      "VLAIO16", IF(IsT1T3, BLANK(), 1),
			                      "VLAIO21", IF(IsT1T3, BLANK(), 1), 1)
			                  RETURN OdooData[Amount] * Coef, 0))
			```
		isHidden
		lineageTag: 1bfae099-076b-4161-988f-315c5f46820b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Remaining Budget vs Revenues Booked' =
			VAR MaxDate = MAX(Dates[Date])
			RETURN
			[Total Budget] - CALCULATE(
			    SUM(Milestones[Line Amount]),
			    REMOVEFILTERS(Dates),
			    Milestones[Milestone date] <= MaxDate,
			    Milestones[msdyn_invoicestatus] = 192350003
			)
		isHidden
		lineageTag: ad6ac83e-1f48-471d-89bb-8f4fe01c4786

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Remaining Budget vs Claimable Costs' =
			VAR MaxDate = MAX(Dates[Date])
			RETURN
			[Total Budget] - CALCULATE(
			    SUMX(
			        FILTER(OdooData, OdooData[Date] <= MaxDate),
			        VAR ProjType = LOOKUPVALUE(Projects[ContractType], Projects[VKI Stat Number], OdooData[StatNumber])
			        VAR Journal   = OdooData[AnalyticalJournal]
			        VAR Coef = SWITCH(TRUE(),
			            LEFT(ProjType,2) = "EU", SWITCH(TRUE(),
			                Journal = "T1 Manpower",         1.25,
			                Journal = "T4 Subcontracting",   1.25,
			                Journal = "T5 Other Costs",       1.25,
			                Journal = "T6 Travel",            1.25,
			                1.0),
			            ProjType = "FOD", SWITCH(TRUE(),
			                Journal = "T1 Manpower",         1.15,
			                Journal = "T4 Subcontracting",   1.15,
			                Journal = "T5 Other Costs",       1.15,
			                Journal = "T6 Travel",            1.15,
			                1.0),
			            1.0)
			        RETURN IF(Journal <> "WANI" && Journal <> "Invoice",
			            -1 * OdooData[Amount] * Coef, 0)
			    ),
			    REMOVEFILTERS(Dates)
			)
		isHidden
		lineageTag: c1186866-4102-49d3-8ce5-f999bdfcd1aa

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Sum of milestone amounts with status=Posted
	measure 'Approved Milestones' = CALCULATE(SUM(Milestones[Line Amount]), Milestones[MilestoneStatus] = "Posted")
		formatString: "€"#,0.00
		lineageTag: 5fb77c11-5f1b-4296-aa3e-0a01407911eb

	/// Sum of all milestone amounts
	measure 'Planned Milestones' = SUM(Milestones[Line Amount])
		formatString: "€"#,0.00
		lineageTag: ec1cdb1e-7128-4f6d-8c7a-8294dba33d60

	/// Billed Sales from msdyn_actual = amount submitted to client
	measure 'Requested Amount' = CALCULATE(SUM(msdyn_actual[Amount]), msdyn_actual[Transaction Type] = "Billed Sales")
		formatString: "€"#,0.00
		lineageTag: e764d27b-559a-438b-8387-2da532db60c8

	/// Count of Not Ready milestones
	measure 'Not Ready Count' = CALCULATE(COUNTROWS(Milestones), Milestones[MilestoneStatus] = "Not Ready")
		formatString: 0
		lineageTag: da048769-9a74-434e-aa72-a2e27ece7357

	/// Count of Posted (Approved) milestones
	measure 'Posted Count' = CALCULATE(COUNTROWS(Milestones), Milestones[MilestoneStatus] = "Posted")
		formatString: 0
		lineageTag: 2feddadc-5479-4c8a-8c20-55e5abb42953

	/// Approved amount / Total planned amount
	measure 'Milestone Completion %' = DIVIDE(CALCULATE(SUM(Milestones[Line Amount]), Milestones[MilestoneStatus] = "Posted"), SUM(Milestones[Line Amount]), 0)
		formatString: 0.0%
		lineageTag: 821b0d45-c16e-45b1-90ff-0f5634c1dbf1

