	column ProjectStatNr =
			VAR _p   = msdyn_actual[Project]
			VAR _sep = FIND(" - ", _p, 1, 0)
			RETURN IF(_sep > 0, LEFT(_p, _sep - 1), BLANK())
		dataType: string
		isHidden
		lineageTag: e3b11011-eb7b-40ea-bc9e-844a9a3592b8

	column 'Expense Type D365' =
			VAR _cat = msdyn_actual[Transaction category]
			VAR _travel_names = {
			    "Meals", "Hotel", "Mileage", "Metro/tram/bus/taxi", "Parking",
			    "Air ticket", "Train ticket", "Taxi", "Ferry", "Car rental", "Fuel",
			    "Flight", "Train", "Renting car short term", "Conference registrations"
			}
			VAR _travel_gl = {
			    "61460000", "61511000", "61511010", "61511020", "61511030", "61620000"
			}
			VAR _manpower_gl = {
			    "45300000", "45400000", "45400010", "45410000", "45900000", "49900030",
			    "61700000", "62301000", "62301700", "62302000", "62302010", "62302020"
			}
			VAR _subcont_gl   = { "61800000", "61900000" }
			VAR _amort_gl     = { "63021000", "63021020", "63021050" }
			VAR _amort_ict_gl = { "63021010" }
			VAR _other_gl     = { "74000090" }
			VAR _exclu_gl     = { "48000000" }
			RETURN
			SWITCH(TRUE(),
			    msdyn_actual[Transaction Type] <> "Cost",          BLANK(),
			    msdyn_actual[VKI Task Type] = "Billing Milestone", BLANK(),
			    _cat IN _exclu_gl,                                 BLANK(),
			    _cat IN _travel_names,                             "T6 Travel",
			    _cat IN _travel_gl,                                "T6 Travel",
			    _cat IN _manpower_gl,                              "T1/T3 Manpower",
			    _cat IN _subcont_gl,                               "T5 Subcontractors",
			    _cat IN _amort_ict_gl,                             "T4 Amortization ICT",
			    _cat IN _amort_gl,                                 "T4 Amortization",
			    _cat IN _other_gl,                                 "Other",
			    LEFT(_cat, 1) = "6",                               "T5 Material Purch.",
			    "DC Unassigned"
			)
		dataType: string
		lineageTag: 531b8f63-43a4-4cdd-8421-d70c3288e5f9

	column 'VKI FY' = IF(MONTH([Accounting Date]) >= 10, YEAR([Accounting Date]) + 1, YEAR([Accounting Date]))
		dataType: int64
		lineageTag: b7bf43d8-1e38-4b7d-8909-ef77fb84043d

	column 'Payment Date Finance' = ```
			
			LOOKUPVALUE(
			    GL_HEADER[AccountingDate],
			    GL_HEADER[SubledgerVoucher], [Voucher Number]
			)
			
			```
		dataType: dateTime
		formatString: dd/mm/yyyy
		lineageTag: 9e6c405c-ad51-4a61-93f9-b494df756099

	partition msdyn_actual = m
		mode: import
		source =
				let
				    Source = CommonDataService.Database("operations-vki-prod.crm4.dynamics.com"),
				    dbo_msdyn_actual = Source{[Schema="dbo",Item="msdyn_actual"]}[Data]
				in
