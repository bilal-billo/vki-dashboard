	measure _HTML_Planning_Table = ```
			
			          VAR _header = "<table style='width:100%;border-collapse:collapse;font-family:Segoe UI,sans-serif;font-size:11px'><thead><tr
			  style='background:#106EBE;color:white'><th style='padding:9px 10px;text-align:left'>CS Start</th><th style='padding:9px 10px;text-align:left'>Milestone
			  Date</th><th style='padding:9px 10px;text-align:right'>Amount (€)</th><th style='padding:9px 10px;text-align:center'>Status</th><th style='padding:9px
			  10px;text-align:center'>Timeline</th></tr></thead><tbody>"
			          VAR _rows = CONCATENATEX(
			              TOPN(150, Milestones, Milestones[Milestone date], ASC),
			              VAR _sc = Milestones[msdyn_invoicestatus]
			              VAR _st = Milestones[MilestoneStatus]
			              VAR _col = IF(_sc=192350003,"#107C10",IF(_sc=192350001,"#FF8C00","#D13438"))
			              VAR _tl = IF(_sc=192350003,"✅ Done",IF(Milestones[Milestone date]<TODAY(),"⚠️ Overdue",IF(Milestones[Milestone date]<=TODAY()+90,"⚡ Next
			  90d","📅 Planned")))
			              RETURN "<tr style='border-bottom:1px solid #F0F0F0'><td style='padding:7px 10px;color:#605E5C'>" & FORMAT(Milestones[Date],"DD/MM/YYYY") &
			  "</td><td style='padding:7px 10px;color:#605E5C'>" & FORMAT(Milestones[Milestone date],"DD/MM/YYYY") & "</td><td style='padding:7px
			  10px;text-align:right;font-weight:600'>€" & FORMAT(Milestones[Line Amount],"#,##0") & "</td><td style='padding:7px 10px;text-align:center'><span
			  style='background:" & _col & ";color:white;padding:2px 7px;border-radius:10px;font-size:10px'>" & _st & "</span></td><td style='padding:7px
			  10px;text-align:center'>" & _tl & "</td></tr>",
			              "",
			              Milestones[Milestone date], ASC
			          )
			          RETURN _header & _rows & "</tbody></table>"
			```
		isHidden
		lineageTag: 16bb9735-a907-481f-b709-0bb8032e18ae

