	measure _HTML_Claimable_Table = ```
			
			  VAR _style = "<style>*{box-sizing:border-box;margin:0;padding:0}body{font-family:'Segoe
			  UI',sans-serif;font-size:11px;background:white;padding:8px}table{width:100%;border-collapse:collapse}thead
			  tr{background:#106EBE;color:white}th{padding:8px 10px;font-size:10px;font-weight:600;text-align:left;white-space:nowrap}th.r{text-align:right}tbody
			  tr{border-bottom:1px solid #F0F0F0}tbody tr:hover{background:#F5F5F5}td{padding:6px
			  10px;font-size:11px}td.r{text-align:right;font-weight:600}td.c{text-align:center}.badge{display:inline-block;padding:2px
			  8px;border-radius:10px;font-size:10px;font-weight:600;color:white}.bp{background:#107C10}.br{background:#FF8C00}.bn{background:#D13438}tfoot
			  td{background:#F0F4F8;font-weight:700;padding:8px 10px;border-top:2px solid #106EBE}</style>"
			  VAR _hdr = "<table><thead><tr><th>Stat Nr</th><th>CS Start</th><th>Milestone Date</th><th class='r'>Amount (€)</th><th
			  class='c'>Status</th><th>Type</th></tr></thead><tbody>"
			  VAR _data = ADDCOLUMNS(
			      Milestones,
			      "StatNr", RELATED(Projects[VKI Stat Number]),
			      "ProjType", RELATED(Contracts[VKI Project Type])
			  )
			  VAR _rows = CONCATENATEX(
			      TOPN(150, _data, Milestones[Milestone date], ASC),
			      "<tr><td><b>" & [StatNr] & "</b></td>" &
			      "<td>" & FORMAT(Milestones[Date],"DD/MM/YY") & "</td>" &
			      "<td>" & FORMAT(Milestones[Milestone date],"DD/MM/YY") & "</td>" &
			      "<td class='r'>€" & FORMAT(Milestones[Line Amount],"#,##0") & "</td>" &
			      "<td class='c'><span class='badge " &
			          IF(Milestones[msdyn_invoicestatus]=192350003,"bp",
			          IF(Milestones[msdyn_invoicestatus]=192350001,"br","bn")) &
			      "'>" & Milestones[MilestoneStatus] & "</span></td>" &
			      "<td>" & [ProjType] & "</td></tr>",
			      "",
			      Milestones[Milestone date],
			      ASC
			  )
			  VAR _foot = "<tfoot><tr><td colspan='3'>TOTAL</td><td class='r'>€" & FORMAT([Total Milestones Amount],"#,##0") & "</td><td colspan='2'></td></tr></tfoot>"
			  RETURN _style & _hdr & _rows & "</tbody>" & _foot & "</table>"
			```
		isHidden
		lineageTag: 8f57f497-5fce-4d5e-b5a7-c00febec3585

	measure _HTML_Overview_KPIs = ```
			
			  VAR _b  = [Total Budget]
			  VAR _m  = [Total Milestones Amount]
			  VAR _i  = [Total Invoiced]
			  VAR _w  = [WANI Balance]
			  VAR _r  = [Remaining Budget]
			  VAR _bup = DIVIDE(_m, _b, 0)
			  VAR _rrp = DIVIDE(_r, _b, 0)
			  VAR _bf = "€" & FORMAT(_b/1000000,"0.0") & "M"
			  VAR _mf = "€" & FORMAT(_m/1000000,"0.0") & "M"
			  VAR _if = "€" & FORMAT(_i/1000000,"0.0") & "M"
			  VAR _wf = "€" & FORMAT(_w/1000000,"0.0") & "M"
			  VAR _rf = "€" & FORMAT(_r/1000000,"0.0") & "M"
			  VAR _rp = FORMAT(_rrp * 100,"0") & "% restant"
			  VAR _bp = FORMAT(_bup * 100,"0.0") & "%"
			  VAR _bw = FORMAT(IF(_bup > 1, 100, _bup * 100),"0") & "%"
			  RETURN
			  "<div style='font-family:Segoe UI,sans-serif;padding:10px'>" &
			  "<div style='display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;margin-bottom:8px'>" &
			  "<div style='background:linear-gradient(135deg,#0078D4,#005A9E);border-radius:8px;padding:12px 14px;color:white'><div
			  style='font-size:9px;opacity:0.85;text-transform:uppercase;letter-spacing:1px;margin-bottom:3px'>Original Budget</div><div
			  style='font-size:20px;font-weight:700'>" & _bf & "</div></div>" &
			  "<div style='background:linear-gradient(135deg,#107C10,#0B5E0B);border-radius:8px;padding:12px 14px;color:white'><div
			  style='font-size:9px;opacity:0.85;text-transform:uppercase;letter-spacing:1px;margin-bottom:3px'>Revenues</div><div
			  style='font-size:20px;font-weight:700'>" & _mf & "</div></div>" &
			  "<div style='background:linear-gradient(135deg,#CA5010,#A03D0A);border-radius:8px;padding:12px 14px;color:white'><div
			  style='font-size:9px;opacity:0.85;text-transform:uppercase;letter-spacing:1px;margin-bottom:3px'>All Invoiced</div><div
			  style='font-size:20px;font-weight:700'>" & _if & "</div></div>" &
			  "</div>" &
			  "<div style='display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px'>" &
			  "<div style='background:linear-gradient(135deg,#038387,#025F63);border-radius:8px;padding:12px 14px;color:white'><div
			  style='font-size:9px;opacity:0.85;text-transform:uppercase;letter-spacing:1px;margin-bottom:3px'>WANI Balance</div><div
			  style='font-size:20px;font-weight:700'>" & _wf & "</div><div style='font-size:9px;opacity:0.75'>Posted - Invoiced</div></div>" &
			  "<div style='background:linear-gradient(135deg,#8764B8,#6A4E9C);border-radius:8px;padding:12px 14px;color:white'><div
			  style='font-size:9px;opacity:0.85;text-transform:uppercase;letter-spacing:1px;margin-bottom:3px'>Remaining Budget</div><div
			  style='font-size:20px;font-weight:700'>" & _rf & "</div><div style='font-size:9px;opacity:0.75'>" & _rp & "</div></div>" &
			  "<div style='background:white;border:1px solid #E0E0E0;border-radius:8px;padding:12px 14px'><div
			  style='font-size:9px;color:#605E5C;text-transform:uppercase;letter-spacing:1px;margin-bottom:6px'>Budget Used</div><div
			  style='font-size:20px;font-weight:700;color:#0078D4'>" & _bp & "</div><div
			  style='background:#EDEBE9;height:8px;border-radius:4px;margin-top:6px;overflow:hidden'><div style='background:#0078D4;height:100%;width:" & _bw &
			  "'></div></div></div>" &
			  "</div></div>"
			```
		isHidden
		lineageTag: 5fc2fce0-8aab-4d79-b009-18291b711053

