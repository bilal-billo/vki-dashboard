	measure _HTML_Budget_Progress = ```
			
			          VAR _b = [Total Budget]
			          VAR _m = [Total Milestones Amount]
			          VAR _i = [Total Invoiced]
			          VAR _r = [Remaining Budget]
			          VAR _pm = FORMAT(DIVIDE(_m,_b,0)*100,"0") & "%"
			          VAR _pi = FORMAT(DIVIDE(_i,_b,0)*100,"0") & "%"
			          RETURN
			          "<div style='font-family:Segoe UI,sans-serif;padding:16px'>" &
			          "<table style='width:100%;border-collapse:collapse;font-size:13px'>" &
			          "<tr><td style='padding:10px 0;color:#605E5C;border-bottom:1px solid #F0F0F0'>Original VKI Grant</td><td
			  style='text-align:right;font-weight:700;font-size:15px;border-bottom:1px solid #F0F0F0'>€" & FORMAT(_b,"#,##0") & "</td></tr>" &
			          "<tr><td style='padding:10px 0;color:#605E5C;border-bottom:1px solid #F0F0F0'>Revenue Milestones</td><td
			  style='text-align:right;font-weight:700;color:#0078D4;font-size:15px;border-bottom:1px solid #F0F0F0'>€" & FORMAT(_m,"#,##0") & " <span
			  style=""font-size:11px"">(" & _pm & ")</span></td></tr>" &
			          "<tr><td style='padding:10px 0;color:#605E5C;border-bottom:1px solid #F0F0F0'>All Invoiced</td><td
			  style='text-align:right;font-weight:700;color:#CA5010;font-size:15px;border-bottom:1px solid #F0F0F0'>€" & FORMAT(_i,"#,##0") & " <span
			  style=""font-size:11px"">(" & _pi & ")</span></td></tr>" &
			          "<tr><td style='padding:10px 0;font-weight:700;font-size:14px'>Remaining Budget</td><td
			  style='text-align:right;font-weight:700;font-size:18px;color:" & IF(_r>0,"#107C10","#D13438") & "'>€" & FORMAT(_r,"#,##0") & "</td></tr>" &
			          "</table></div>"
			```
