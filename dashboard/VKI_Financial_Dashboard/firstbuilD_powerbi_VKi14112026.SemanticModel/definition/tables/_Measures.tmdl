	measure 'WANI New D365' =
			CALCULATE(
			    SUM(BOB_OUT[AccountingCurrencyAmount]),
			    CONTAINSSTRING(BOB_OUT[LedgerDimensionValuesJson], "37000000"),
			    BOB_OUT[AccountingCurrencyAmount] > 0
			)
		formatString: € #,##0
		displayFolder: Revenues
		lineageTag: 8b84be4a-5baf-49e7-aec8-08529a3b8235

	measure 'WANI Cleared D365' =
			CALCULATE(
			    SUM(BOB_OUT[AccountingCurrencyAmount]),
			    CONTAINSSTRING(BOB_OUT[LedgerDimensionValuesJson], "37000000"),
			    BOB_OUT[AccountingCurrencyAmount] < 0
			)
		formatString: € #,##0
		displayFolder: Revenues
		lineageTag: 1246b267-24b1-426d-ba42-55fc874ce570

	measure 'WANI Balance D365' =
			
			VAR _maxDate = MAX(GL_HEADER[AccountingDate_Date])
			RETURN
			CALCULATE(
			    SUM(BOB_OUT[AccountingCurrencyAmount]),
			    CONTAINSSTRING(BOB_OUT[LedgerDimensionValuesJson], "37000000"),
			    REMOVEFILTERS(GL_HEADER),
			    REMOVEFILTERS(Dates),
			    GL_HEADER[AccountingDate_Date] <= _maxDate
			)
		formatString: € #,##0
		displayFolder: Revenues
		lineageTag: 6c75ee6a-fab9-4002-bd25-f4a0ebf0da6c

	measure 'Revenues D365' =
			
			VAR _inv  = COALESCE([Revenue Invoiced D365], 0)
			VAR _wNew = COALESCE([WANI New D365], 0)
			VAR _wClr = COALESCE([WANI Cleared D365], 0)
			RETURN _inv + _wNew + _wClr
		formatString: € #,##0
		displayFolder: Revenues
		lineageTag: 37fd74e9-0f12-4464-bdbf-c00c795efbb6

	measure 'Direct Costs msdyn D365' =
			CALCULATE(
			    SUM(msdyn_actual[Amount]),
			    msdyn_actual[Transaction Type] = "Cost",
			    FILTER(msdyn_actual, LEFT(msdyn_actual[Transaction category], 8) <> "48000000")
			)
		formatString: #,0.0
		lineageTag: 11b9f7bc-21f7-42f8-8afb-1f142744dee8

	measure 'DC Travel msdyn D365' =
			CALCULATE(
			    SUM(msdyn_actual[Amount]),
			    msdyn_actual[Transaction Type] = "Cost",
			    msdyn_actual[Transaction category] IN {"Meals","Hotel","Mileage","Metro/tram/bus/taxi","Parking","Air ticket","Train ticket","Taxi"}
			)
		formatString: #,0.0
		lineageTag: 585aaade-4040-4cf7-ab69-ffedfd41da32

	measure 'DC Other msdyn D365' =
			CALCULATE(
			    SUM(msdyn_actual[Amount]),
			    msdyn_actual[Transaction Type] = "Cost",
			    NOT msdyn_actual[Transaction category] IN {"Meals","Hotel","Mileage","Metro/tram/bus/taxi","Parking","Air ticket","Train ticket","Taxi"}
			)
		formatString: #,0.0
		lineageTag: 4c69bacf-509b-4e14-be6c-72baf8923351

	measure 'Direct Costs D365' = [Direct Costs msdyn D365]
		formatString: #,0.0
		isHidden
		lineageTag: 81ffe486-64e3-4ca0-a34e-da23fdc6f804

	measure 'Direct Costs + VKI OH D365' = [Direct Costs + OH msdyn D365]
		formatString: #,0.0
		isHidden
		lineageTag: 51c0402b-3bec-4449-915e-e8636c719621

	measure 'Claimable Costs D365' = ```
			
			SUMX(
			    FILTER(
			        msdyn_actual,
			        msdyn_actual[Transaction Type] = "Cost"
			        && NOT ISBLANK(msdyn_actual[Expense Type D365])
			    ),
			    VAR _exp  = msdyn_actual[Expense Type D365]
			    VAR _proj = RELATED(Projects[ContractType])
			    VAR _isT1T3    = _exp = "T1/T3 Manpower"
			    VAR _isT5Subco = _exp = "T5 Subcontractors"
			    VAR _isT4      = _exp IN {"T4 Amortization", "T4 Amortization ICT"}
			    VAR _coef = SWITCH(TRUE(),
			        LEFT(_proj, 2) = "EU",   IF(_isT5Subco, 1.0, 1.25),
			        _proj = "FOD",            1.15,
			        _proj = "PRODEX",         IF(_isT5Subco || _isT4, 1.0, 1.05),
			        _proj = "RW",             IF(_isT1T3, BLANK(), 1.17),
			        _proj = "VLAIO16",        IF(_isT1T3, BLANK(), 1.0),
			        _proj = "VLAIO21",        IF(_isT1T3, BLANK(), 1.0),
			        1.0
			    )
			    RETURN msdyn_actual[Amount] * _coef
			)
			
			```
		lineageTag: 38b5ee85-1a46-4510-a8fa-43574c7e3e7a

	measure 'Direct Costs OH msdyn D365' = ```
			
			SUMX(
			    FILTER(
			        msdyn_actual,
			        msdyn_actual[Transaction Type] = "Cost"
			        && msdyn_actual[Expense Type D365] = "T1/T3 Manpower"
			    ),
			    msdyn_actual[Amount] * 0.55
			)
			
			```
		lineageTag: 1a9ae855-9455-4864-a542-5bbf49d76238

	measure 'Direct Costs + OH msdyn D365' = ```
			
			COALESCE([Direct Costs msdyn D365], 0)
			+ COALESCE([Direct Costs OH msdyn D365], 0)
			
			```
		lineageTag: fc0a3679-9a42-403a-9d94-42b3d2a2e0c7

	measure 'Payments In D365' = ```
			
			CALCULATE(
			    SUM(msdyn_actual[Amount]),
			    msdyn_actual[Transaction Type] = "Billed Sales"
			)
			
			```
		formatString: "€"#,0.00
		lineageTag: e5339a8b-e948-4778-a411-1097132218a1

	measure 'Payments to Partners D365' = ```
			
			CALCULATE(
			    SUM(msdyn_actual[Amount]),
			    msdyn_actual[Transaction category] = "48000000"
			)
			
			```
		formatString: "€"#,0.00
		lineageTag: 1f071909-8f4c-492d-bb55-b3f0f979bc38

	measure 'Advanced Payments D365' = ```
			
			CALCULATE(
			    SUM(BOB_OUT[AccountingCurrencyAmount]),
			    LEFT(BOB_OUT[MainAccount], 2) = "46"
			)
			
			```
		formatString: "€"#,0.00
		lineageTag: 22b2b317-77f0-4fa4-a78e-fe75a370eb5e

	measure 'Planned VKI' = SUM(Milestones[Line Amount])
