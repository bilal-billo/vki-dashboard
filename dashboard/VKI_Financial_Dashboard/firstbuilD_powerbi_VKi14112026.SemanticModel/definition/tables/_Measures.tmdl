	measure _HTML_Budget_Chart = ```
			
			  VAR _Bgt = [Total Budget]
			  VAR _BgtK = ROUND(_Bgt / 1000, 1)
			  VAR _Qtrs = CALCULATETABLE(
			      SUMMARIZE(Dates, Dates[YearQuarter]),
			      FILTER(Dates, YEAR(Dates[Date]) >= 2020),
			      FILTER(Dates, Dates[Date] <= TODAY())
			  )
			  VAR _n = COUNTROWS(_Qtrs)
			  VAR _Data = ADDCOLUMNS(
			      _Qtrs,
			      "RevK", ROUND(DIVIDE(CALCULATE(
			          SUM(Milestones[Line Amount]),
			          Milestones[msdyn_invoicestatus] = 192350003,
			          FILTER(ALL(Dates), Dates[YearQuarter] <= [YearQuarter])
			      ), 1000), 1),
			      "Rk", RANKX(_Qtrs, [YearQuarter], , ASC, Dense)
			  )
			  VAR _yMx = _BgtK * 1.15
			  VAR _W = 680  VAR _H = 170  VAR _PL = 52  VAR _PT = 8  VAR _PB = 28
			  VAR _TW = _PL + _W + 10  VAR _TH = _PT + _H + _PB
			  VAR _PtsBgt = CONCATENATEX(_Data,
			      FORMAT(_PL + _W * ([Rk]-1) / IF(_n>1,_n-1,1), "0") & "," &
			      FORMAT(_PT + _H * (1 - _BgtK / _yMx), "0"),
			      " ", [YearQuarter], ASC)
			  VAR _PtsRev = CONCATENATEX(_Data,
			      FORMAT(_PL + _W * ([Rk]-1) / IF(_n>1,_n-1,1), "0") & "," &
			      FORMAT(_PT + _H * (1 - (_BgtK - [RevK]) / _yMx), "0"),
			      " ", [YearQuarter], ASC)
			  VAR _XLbl = CONCATENATEX(_Data,
			      IF(MOD([Rk]-1, CEILING(_n/8,1)) = 0 || [Rk] = _n,
			      "<text x='" & FORMAT(_PL + _W*([Rk]-1)/IF(_n>1,_n-1,1),"0") &
			      "' y='" & FORMAT(_PT+_H+18,"0") &
			      "' text-anchor='middle' font-size='9' fill='#888'>" & [YearQuarter] & "</text>", ""),
			      "", [YearQuarter], ASC)
			  VAR _YLbl =
			      "<text x='" & FORMAT(_PL-4,"0") & "' y='" & FORMAT(_PT+4,"0") & "' text-anchor='end' font-size='9' fill='#888'>" & FORMAT(_yMx,"0") & "K</text>" &
			      "<text x='" & FORMAT(_PL-4,"0") & "' y='" & FORMAT(_PT+_H/2+4,"0") & "' text-anchor='end' font-size='9' fill='#888'>" & FORMAT(_yMx/2,"0") & "K</text>" &
			      "<text x='" & FORMAT(_PL-4,"0") & "' y='" & FORMAT(_PT+_H+4,"0") & "' text-anchor='end' font-size='9' fill='#888'>0K</text>"
			  VAR _Grid =
			      "<line x1='" & _PL & "' y1='" & FORMAT(_PT,"0") & "' x2='" & FORMAT(_PL+_W,"0") & "' y2='" & FORMAT(_PT,"0") & "' stroke='#F0F0F0' stroke-width='1'/>" &
			      "<line x1='" & _PL & "' y1='" & FORMAT(_PT+_H/2,"0") & "' x2='" & FORMAT(_PL+_W,"0") & "' y2='" & FORMAT(_PT+_H/2,"0") & "' stroke='#F0F0F0' stroke-width='1'/>" &
			      "<line x1='" & _PL & "' y1='" & FORMAT(_PT+_H,"0") & "' x2='" & FORMAT(_PL+_W,"0") & "' y2='" & FORMAT(_PT+_H,"0") & "' stroke='#E0E0E0' stroke-width='1'/>"
			  RETURN
			  "<div style='font-family:Segoe UI,sans-serif;padding:8px;background:white'>" &
			  "<div style='font-size:12px;font-weight:600;text-align:center;margin-bottom:5px'>Remaining Budget over Time</div>" &
			  "<div style='display:flex;gap:16px;justify-content:center;margin-bottom:5px;font-size:10px'>" &
			  "<span><span style='display:inline-block;width:14px;height:3px;background:#0078D4;margin-right:3px;vertical-align:middle'></span>Initial Grant</span>" &
			  "<span><span style='display:inline-block;width:14px;height:3px;background:#CA5010;margin-right:3px;vertical-align:middle'></span>Remaining vs Revenues Booked</span></div>" &
			  "<svg width='100%' viewBox='0 0 " & FORMAT(_TW,"0") & " " & FORMAT(_TH,"0") & "'>" &
			  _Grid & _YLbl &
			  "<polyline points='" & _PtsBgt & "' fill='none' stroke='#0078D4' stroke-width='2'/>" &
			  "<polyline points='" & _PtsRev & "' fill='none' stroke='#CA5010' stroke-width='2'/>" &
			  _XLbl &
			  "</svg></div>"
			```
		isHidden
		lineageTag: cc9c024e-566d-4677-ab63-a9002dadcec3

